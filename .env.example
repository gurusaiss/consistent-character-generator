# ── Server ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
PORT=3001
NODE_ENV=development

# ── Optional generation providers (app degrades gracefully if any are unset) ─
# Together AI — free tier, FLUX.1-schnell-Free (api.together.xyz)
TOGETHER_API_KEY=your_together_api_key_here
# Cloudflare Workers AI — free tier, 10k neurons/day (dash.cloudflare.com)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
# fal.ai — paid balance required; powers PuLID face-conditioning, LoRA
# training, face-swap, and ESRGAN upscaling (fal.ai/dashboard/keys)
FAL_KEY=your_fal_api_key_here

# ── Supabase (server — service role key, NEVER expose to browser) ────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Supabase (client — safe to expose, anon key only) ───────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
